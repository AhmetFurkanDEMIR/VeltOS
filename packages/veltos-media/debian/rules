#!/usr/bin/make -f

export PYBUILD_NAME = veltos-media

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d debian/veltos-media/usr/lib/python3/dist-packages
	cp -r veltos_media debian/veltos-media/usr/lib/python3/dist-packages/
	find debian/veltos-media -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-media debian/veltos-media/usr/bin/veltos-media
	install -D -m 644 data/veltos-media.desktop \
		debian/veltos-media/usr/share/applications/veltos-media.desktop
	install -D -m 644 data/veltos-media.svg \
		debian/veltos-media/usr/share/icons/hicolor/scalable/apps/veltos-media.svg

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
