#!/usr/bin/make -f

export PYBUILD_NAME = veltos-settings

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d debian/veltos-settings/usr/lib/python3/dist-packages
	cp -r veltos_settings debian/veltos-settings/usr/lib/python3/dist-packages/
	find debian/veltos-settings -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-settings debian/veltos-settings/usr/bin/veltos-settings
	# KDE's settings programs open VeltOS Settings (diverted in the preinst).
	install -D -m 755 bin/veltos-settings-redirect debian/veltos-settings/usr/libexec/veltos/settings-redirect
	# Mobile hotspot for Quick Settings (veltos_settings/hotspot.py).
	install -D -m 755 bin/veltos-hotspot debian/veltos-settings/usr/libexec/veltos/hotspot
	# Its second interface on a Wi-Fi card that is connected (pkexec, no password).
	install -D -m 755 bin/veltos-hotspot-interface debian/veltos-settings/usr/libexec/veltos/hotspot-interface
	install -D -m 644 data/org.veltos.hotspot.policy \
		debian/veltos-settings/usr/share/polkit-1/actions/org.veltos.hotspot.policy
	# The mouse pointer follows light/dark mode (veltos_settings/pointer.py).
	install -D -m 755 bin/veltos-pointer-style debian/veltos-settings/usr/libexec/veltos/pointer-style
	# Plugging in a screen opens Windows 11's Project flyout instead of
	# KDE's chooser (veltos_settings/kscreen_osd.py takes KScreen's bus name).
	install -D -m 755 bin/veltos-kscreen-osd debian/veltos-settings/usr/libexec/veltos/kscreen-osd
	install -D -m 644 data/systemd/plasma-kscreen-osd-veltos.conf \
		debian/veltos-settings/usr/lib/systemd/user/plasma-kscreen-osd.service.d/veltos.conf
	# Bluetooth pairing questions in Windows 11's Add a device window
	# (veltos_settings/btagent.py, started with the session).
	install -D -m 755 bin/veltos-bt-agent debian/veltos-settings/usr/libexec/veltos/bt-agent
	install -D -m 644 data/veltos-bt-agent.desktop debian/veltos-settings/etc/xdg/autostart/veltos-bt-agent.desktop
	install -D -m 644 data/veltos-bluetooth-pair.desktop \
		debian/veltos-settings/usr/share/applications/veltos-bluetooth-pair.desktop
	# Wi-Fi keys in VeltOS' window instead of KDE's (veltos_settings/nmagent.py;
	# veltos-desktop turns off Plasma's own agent, kded's networkmanagement).
	install -D -m 755 bin/veltos-network-agent debian/veltos-settings/usr/libexec/veltos/network-agent
	install -D -m 644 data/veltos-network-agent.desktop \
		debian/veltos-settings/etc/xdg/autostart/veltos-network-agent.desktop
	install -D -m 644 data/veltos-wifi-key.desktop \
		debian/veltos-settings/usr/share/applications/veltos-wifi-key.desktop
	ln -s ../libexec/veltos/settings-redirect debian/veltos-settings/usr/bin/systemsettings
	ln -s ../libexec/veltos/settings-redirect debian/veltos-settings/usr/bin/kcmshell6
	ln -s ../libexec/veltos/settings-redirect debian/veltos-settings/usr/bin/kinfocenter
	ln -s ../libexec/veltos/settings-redirect debian/veltos-settings/usr/bin/keditfiletype
	install -D -m 644 data/veltos-settings.desktop \
		debian/veltos-settings/usr/share/applications/veltos-settings.desktop
	# App icon (VeltOS artwork, Windows 11 style).
	install -D -m 644 data/veltos-settings.svg \
		debian/veltos-settings/usr/share/icons/hicolor/scalable/apps/veltos-settings.svg

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
