#!/usr/bin/python3
"""VeltOS Store (Microsoft Store layout)."""
import os
import sys

os.environ.setdefault("QT_QUICK_CONTROLS_STYLE", "org.kde.desktop")
# Same file times in every package build: compile the QML at start (see
# AGENTS.md, QML disk cache).
os.environ["QML_DISABLE_DISK_CACHE"] = "1"

if "--first-start" in sys.argv[1:]:
    # At every sign-in: decide without loading Qt; usually nothing to show.
    from veltos_store.firstupdate import should_show
    if not should_show():
        sys.exit(0)

from veltos_store.app import main

sys.exit(main())
