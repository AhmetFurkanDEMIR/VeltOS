[Desktop Entry]
Type=Application
Name=Settings
Name[tr]=Ayarlar
Comment=Change how your PC looks and works
Comment[tr]=Bilgisayarınızın görünümünü ve çalışmasını değiştirin
Keywords=settings;preferences;control panel;system;personalization;ayarlar;tercihler;sistem;kişiselleştirme;
Exec=veltos-settings
Icon=veltos-settings
Terminal=false
Categories=Qt;Settings;
StartupNotify=true
Actions=Project;

# Windows + P (and the Display key): Windows 11's Project flyout.
[Desktop Action Project]
Name=Project
Name[tr]=Yansıt
Exec=veltos-settings --project
X-KDE-Shortcuts=Meta+P,Display
