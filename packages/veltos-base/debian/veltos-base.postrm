#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
    if [ -e /usr/share/base-files/motd ] && cmp -s /etc/motd /usr/share/veltos-base/motd 2>/dev/null; then
        install -m 644 /usr/share/base-files/motd /etc/motd
    fi
    for f in /etc/issue /etc/issue.net; do
        if [ -e "$f.debian" ]; then
            rm -f "$f"
        fi
        dpkg-divert --package veltos-base --remove --rename --divert "$f.debian" "$f"
    done
    dpkg-divert --package veltos-base --remove --rename \
        --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
