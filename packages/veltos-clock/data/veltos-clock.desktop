[Desktop Entry]
Type=Application
Name=Clock
Name[tr]=Saat
GenericName=Alarms, timers and world clock
GenericName[tr]=Alarmlar, zamanlayıcılar ve dünya saati
Comment=Alarms, timers, stopwatch, world clock and focus sessions
Comment[tr]=Alarmlar, zamanlayıcılar, kronometre, dünya saati ve odaklanma oturumları
Keywords=alarm;timer;stopwatch;world clock;focus;time;
Keywords[tr]=alarm;zamanlayıcı;kronometre;dünya saati;odaklanma;saat;
Exec=veltos-clock
Icon=veltos-clock
Terminal=false
Categories=Utility;Clock;
StartupNotify=true
X-KDE-StartupNotify=false

Actions=alarm;timer;stopwatch;

