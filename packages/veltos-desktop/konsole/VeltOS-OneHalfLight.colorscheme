# Windows Terminal's light colour scheme "One Half Light", for the VeltOS
# terminal profile in light mode. Colour values from Windows Terminal (MIT
# licence), arranged as a Konsole colour scheme.
# SPDX-License-Identifier: GPL-3.0-or-later

[General]
Description=One Half Light
Opacity=1
Blur=false

[Background]
Color=250,250,250

[BackgroundIntense]
Color=250,250,250

[BackgroundFaint]
Color=250,250,250

[Foreground]
Color=56,58,66

[ForegroundIntense]
Color=40,42,48

[ForegroundFaint]
Color=120,122,130

