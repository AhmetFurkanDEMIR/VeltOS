/*
 * VeltOS installer look: light Windows 11 style controls (rounded buttons
 * and fields, accent underline while typing, accent check boxes, thin
 * scroll bars). Calamares applies this file to every page.
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

* {
    font-family: "Inter";
}

#mainApp, QDialog, QMessageBox {
    background-color: #F3F5FA;
    color: #1B1D24;
}

QLabel {
    color: #1B1D24;
}

/* Pages in scroll areas take the window colour (not Qt's grey). */
QScrollArea, QScrollArea > QWidget > QWidget, QStackedWidget {
    background: transparent;
    border: none;
}

QPushButton {
    background-color: #FFFFFF;
    color: #1B1D24;
    border: 1px solid #D5DAE5;
    border-bottom-color: #C3C9D6;
    border-radius: 6px;
    padding: 6px 16px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #F7F8FC;
}
QPushButton:pressed {
    background-color: #EEF1F7;
    color: #5D6475;
}
QPushButton:disabled {
    background-color: #F7F8FB;
    border-color: #E3E6EE;
    color: #A3A9B8;
}
QPushButton:default, QPushButton:checked {
    background-color: #2F5EE6;
    border: 1px solid #2A55D4;
    color: #FFFFFF;
}

/* Questions (cancel the installation?, ...): roomy, text-only buttons. */
QMessageBox {
    padding: 12px;
}
QMessageBox QLabel {
    padding: 4px 8px;
}
QMessageBox QPushButton, QDialogButtonBox QPushButton {
    icon-size: 0px;
    min-width: 96px;
    padding: 6px 18px;
}

QLineEdit, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #FFFFFF;
    color: #1B1D24;
    border: 1px solid #D5DAE5;
    border-bottom: 1px solid #8A90A2;
    border-radius: 5px;
    padding: 6px 8px;
    selection-background-color: #2F5EE6;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus {
    border-bottom: 2px solid #2F5EE6;
}
QLineEdit:disabled {
    background-color: #F7F8FB;
    color: #A3A9B8;
}

QComboBox {
    background-color: #FFFFFF;
    color: #1B1D24;
    border: 1px solid #D5DAE5;
    border-radius: 5px;
    padding: 5px 10px;
    min-height: 22px;
}
QComboBox:hover {
    background-color: #F7F8FC;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    image: url(/etc/calamares/branding/veltos/images/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D5DAE5;
    padding: 4px;
    outline: 0;
    selection-background-color: #E4E8F3;
    selection-color: #1B1D24;
}

QListView, QTreeView, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FAFBFD;
    color: #1B1D24;
    border: 1px solid #E3E6EE;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
}
QListView::item, QTreeView::item {
    padding: 5px 6px;
    border-radius: 5px;
}
QListView::item:hover, QTreeView::item:hover {
    background-color: #F1F3F9;
}
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #E4E8F3;
    color: #1B1D24;
}
QHeaderView::section {
    background-color: #FFFFFF;
    color: #5D6475;
    border: none;
    border-bottom: 1px solid #E3E6EE;
    padding: 6px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    color: #1B1D24;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #8A90A2;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    background-color: #F1F3F9;
}
QCheckBox::indicator:checked {
    background-color: #2F5EE6;
    border-color: #2F5EE6;
    image: url(/etc/calamares/branding/veltos/images/check.svg);
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #8A90A2;
    border-radius: 10px;
    background-color: #FFFFFF;
}
QRadioButton::indicator:hover {
    background-color: #F1F3F9;
}
QRadioButton::indicator:checked {
    width: 10px;
    height: 10px;
    border: 5px solid #2F5EE6;
    background-color: #FFFFFF;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E3E6EE;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #5D6475;
}

QProgressBar {
    background-color: #E1E5EE;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #2F5EE6;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background-color: #C3C9D6;
    border-radius: 3px;
    min-height: 32px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background-color: #C3C9D6;
    border-radius: 3px;
    min-width: 32px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

QToolTip {
    background-color: #FFFFFF;
    color: #1B1D24;
    border: 1px solid #D5DAE5;
    padding: 4px 8px;
}
