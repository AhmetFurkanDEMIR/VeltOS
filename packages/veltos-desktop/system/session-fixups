#!/bin/sh
# VeltOS adjustments that need the running session (started once at
# sign-in by /etc/xdg/autostart/veltos-session-fixups.desktop, then exits).
#
# Taskbar locked, like Windows 11's: no widgets can be added, moved or
# removed. Plasma's applets follow the lock of the whole shell, not of
# their panel, so each one is locked as well (also those in the tray).
# With the kiosk setting plasma/allow_configure_when_locked
# (/etc/xdg/kdeglobals) they offer no KDE settings dialogs. Scripts
# (VeltOS Settings) can still change the taskbar.
#
# Taskbar window previews: KWin's screen capture gives garbled preview
# images when it renders in software (llvmpipe: virtual machines without 3D
# acceleration; VM test 2026-10-20). There the taskbar shows the window
# title only, like Windows with visual effects off; with a real GPU the
# previews stay on. Decided at every sign-in, so moving a disk between a VM
# and real hardware does the right thing.
#
# The Store is pinned to the taskbar once for users whose taskbar was made
# before it existed (new users get it from the layout script); unpinning it
# is kept.
set -u

state="${XDG_STATE_HOME:-$HOME/.local/state}/veltos"
pin_store=true
[ -e "$state/taskbar-store-pinned" ] && pin_store=false

# plasmashell and KWin answer on the session bus a moment after sign-in.
i=0
while [ $i -lt 30 ]; do
    if qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 &&
       qdbus6 org.kde.KWin /KWin >/dev/null 2>&1; then
        break
    fi
    i=$((i + 1))
    sleep 1
done

# Screens get Windows' scale steps (100, 125, 150 %...) instead of KWin's
# 5 % steps, which blur text and window buttons (see display-scale).
/usr/libexec/veltos/display-scale || true

renderer="$(qdbus6 org.kde.KWin /KWin org.kde.KWin.supportInformation 2>/dev/null |
            sed -n 's/^OpenGL renderer string: //p' | head -n 1)"
case "$renderer" in
    ""|*llvmpipe*|*softpipe*|*"Software Rasterizer"*) previews=false ;;
    *) previews=true ;;
esac

# Applets still loading may reset their lock from the saved layout, so
# the script runs twice.
script="
function lockAll(containment) {
    containment.locked = true;
    containment.widgets().forEach(function (widget) {
        widget.locked = true;
    });
}
// Desktop icons in date order (see layout.js), also for users from before
// it; once per desktop, so that 'Sort by' in the desktop's menu (the
// plasma override of the folder view) keeps what the user chose.
desktops().forEach(function (desktop) {
    desktop.currentConfigGroup = ['General'];
    if (desktop.readConfig('veltosDateOrder', false) !== true) {
        desktop.writeConfig('sortMode', 2);
        desktop.writeConfig('sortDirsFirst', false);
        desktop.writeConfig('veltosDateOrder', true);
    }
    // No hover buttons on the icons (see layout.js), also for users from
    // before them; nothing in VeltOS turns them on.
    desktop.writeConfig('selectionMarkers', false);
    desktop.writeConfig('popups', false);
});
panels().forEach(function (panel) {
    lockAll(panel);
    panel.widgets('org.kde.plasma.systemtray').forEach(function (tray) {
        var id = tray.readConfig('SystrayContainmentId');
        if (id) {
            lockAll(desktopById(id));
        }
    });
    ['org.kde.plasma.icontasks', 'org.kde.plasma.taskmanager'].forEach(function (id) {
        panel.widgets(id).forEach(function (tasks) {
            tasks.currentConfigGroup = ['General'];
            tasks.writeConfig('showToolTips', $previews);
            if ($pin_store) {
                var launchers = tasks.readConfig('launchers', []);
                if (typeof launchers === 'string') {
                    launchers = launchers ? launchers.split(',') : [];
                }
                if (launchers.indexOf('applications:veltos-store.desktop') < 0) {
                    tasks.writeConfig('launchers', launchers.concat(['applications:veltos-store.desktop']));
                }
            }
        });
    });
});"
qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script" >/dev/null 2>&1 &&
    mkdir -p "$state" && : > "$state/taskbar-store-pinned"
sleep 15
qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script" >/dev/null 2>&1
exit 0
