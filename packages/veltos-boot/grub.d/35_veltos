#!/bin/sh
# Installed as /etc/grub.d/35_veltos (veltos-boot).
#
# Text GRUB prints while starting VeltOS ("Booting ...", "Loading Linux
# ...") is drawn black on black, so the screen goes from the firmware logo
# straight to the VeltOS boot screen. The themed menu has its own colours.
#
# The menu is hidden like on Windows (GRUB_TIMEOUT_STYLE=hidden), also
# when other operating systems are installed (Debian's 30_os-prober shows it
# then; the product owner did not want it, 2026-10-26): F1 while GRUB waits,
# or held down while the PC starts, shows the boot menu, where Windows and
# the other entries are (Esc, F4 or Shift also do, GRUB's own keys). F1 is
# the hotkey of a "Boot menu" entry that reads grub.cfg again with
# veltos_menu=1, and then this script shows the menu and leaves that entry
# out (GRUB 2.12 starts an entry's hotkey during a hidden wait, and has no
# hidden entries). With Automatic Repair (veltos-recovery, see 10_linux)
# GRUB shows the VeltOS start screen while it waits - the boot splash's
# background and logo with small "F1  Boot menu" and "F6  Recovery" hints
# in the bottom right corner (product owner, 2026-10-23) - and F6 starts
# VeltOS Recovery; the menu also stays hidden after a start that did not
# finish (Debian shows it for 30 s then; VeltOS counts such starts and
# opens Automatic Repair after two).
set -e

recovery_unit="${VELTOS_RECOVERY_UNIT:-/usr/lib/systemd/system/veltos-recovery.target}"   # test hooks
start_screen="${VELTOS_START_SCREEN:-/usr/libexec/veltos-boot/start-screen}"
screen_dir="${VELTOS_START_SCREEN_DIR:-/boot/grub/veltos}"
locale_file="${VELTOS_LOCALE_FILE:-/etc/default/locale}"

cat <<'GRUB'
set color_normal=black/black
set color_highlight=black/black
GRUB

# As 10_linux decides whether VeltOS Recovery exists.
grubenv_writable() {
    fs="$(grub-probe --target=fs /boot/grub 2>/dev/null || true)"
    case "$fs" in
        btrfs|zfs|cpiofs|newc|odc|romfs|squash4|tarfs) return 1 ;;
    esac
    abstraction="$(grub-probe --target=abstraction /boot/grub 2>/dev/null || true)"
    [ -z "$abstraction" ]
}

cat <<'GRUB'
if [ "${veltos_menu}" = 1 ]; then
  # F1 was pressed: the boot menu, until an entry is chosen.
  set timeout_style=menu
  set timeout=-1
else
  menuentry 'Boot menu' --hotkey=f1 --id veltos-boot-menu {
    set veltos_menu=1
    export veltos_menu
    configfile "${prefix}/grub.cfg"
  }
  # Hidden, whatever 30_os-prober decided for other operating systems.
  set timeout_style=hidden
  set timeout=2
GRUB

if [ -e "$recovery_unit" ] && grubenv_writable && [ -x "$start_screen" ]; then
    lang="$(sed -n 's/^LANG=["]\{0,1\}\([^"]*\)["]\{0,1\}$/\1/p' "$locale_file" 2>/dev/null | tail -n 1)"
    if "$start_screen" --mode "${GRUB_GFXMODE:-}" --lang "${lang:-${LANG:-}}" --out "$screen_dir" >&2; then
        cat <<'GRUB'
  # While GRUB waits: the start screen with the "F1  Boot menu" and
  # "F6  Recovery" hints. Every VeltOS entry puts the start screen without
  # the hints back before Linux loads (veltos_start_screen).
  insmod tga
  if background_image -m stretch "${prefix}/veltos/start-hint.tga"; then
    set veltos_screen="${prefix}/veltos/start.tga"
    # gfxterm paints a new background only when it next draws: without
    # this the screen stayed black while GRUB waited (QEMU, 2026-10-24).
    clear
  fi
GRUB
    else
        echo "veltos-boot: the start screen could not be made; GRUB waits without it" >&2
    fi
fi

echo "fi"
