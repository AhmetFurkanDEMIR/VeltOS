#!/usr/bin/make -f

export PYBUILD_NAME = veltos-camera

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d debian/veltos-camera/usr/lib/python3/dist-packages
	cp -r veltos_camera debian/veltos-camera/usr/lib/python3/dist-packages/
	find debian/veltos-camera -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-camera debian/veltos-camera/usr/bin/veltos-camera
	install -D -m 644 data/veltos-camera.desktop \
		debian/veltos-camera/usr/share/applications/veltos-camera.desktop
	install -D -m 644 data/veltos-camera.svg \
		debian/veltos-camera/usr/share/icons/hicolor/scalable/apps/veltos-camera.svg

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
