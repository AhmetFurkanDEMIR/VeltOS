#!/bin/sh
# Start the VeltOS installer (Calamares) from the live session.
# Based on calamares-install-debian (calamares-settings-debian, ISC licence).

# live-build leaves an /etc/fstab that confuses partitioning; move it away
# while the installer runs.
sudo mv /etc/fstab /etc/fstab.orig.calamares 2>/dev/null

# The installer takes the session's look: light or dark, the accent colour,
# software drawing in VMs without 3D (installer-theme reads them as this
# user; start-calamares applies them as root, see there).
theme="$(/usr/libexec/veltos-installer/installer-theme)"

# The side bar's website link: Calamares runs as root, so the page is
# opened in this user's browser by a helper of this user.
/usr/libexec/veltos-installer/open-website &
links=$!

# Calamares runs as root through pkexec; under Wayland it uses Xwayland and
# needs permission to open a window there.
xhost +si:localuser:root >/dev/null
# shellcheck disable=SC2086
pkexec /usr/libexec/veltos-installer/start-calamares $theme
xhost -si:localuser:root >/dev/null

kill "$links" 2>/dev/null
sudo mv /etc/fstab.orig.calamares /etc/fstab 2>/dev/null
exit 0
