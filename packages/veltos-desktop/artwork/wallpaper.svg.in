<?xml version="1.0" encoding="UTF-8"?>
<!--
  VeltOS "Velt Bloom" wallpaper template. SPDX-License-Identifier: CC-BY-SA-4.0

  Translucent folded petals fanning out of one point to form a "V", in the
  spirit of the Windows 11 bloom. tools/build-assets.py fills the
  at-sign-delimited tokens for the light and dark variants and re-crops the viewBox per aspect ratio,
  which is why the background extends far beyond the 3840x2160 canvas.
  The petal shapes and gradients are shared with veltos-logo.svg.
-->
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="3840" height="2160" viewBox="0 0 3840 2160">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="@BG_TOP@"/>
      <stop offset="1" stop-color="@BG_BOTTOM@"/>
    </linearGradient>
    <radialGradient id="glow" cx="1920" cy="1240" r="1650" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="@GLOW@" stop-opacity="@GLOW_OPACITY@"/>
      <stop offset="1" stop-color="@GLOW@" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="2500" cy="700" r="1300" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="@GLOW2@" stop-opacity="@GLOW2_OPACITY@"/>
      <stop offset="1" stop-color="@GLOW2@" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="core">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.85"/>
      <stop offset="0.35" stop-color="#C9DCFF" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#7FA6FF" stop-opacity="0"/>
    </radialGradient>

    <!-- Petal gradients run from the base (bottom) to the tip (top). -->
    <linearGradient id="blue-lit" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#3047D9"/>
      <stop offset="0.55" stop-color="#4F7CFF"/>
      <stop offset="1" stop-color="#B4D2FF"/>
    </linearGradient>
    <linearGradient id="blue-shade" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#1E2A9E"/>
      <stop offset="0.55" stop-color="#3654D6"/>
      <stop offset="1" stop-color="#7FA6FF"/>
    </linearGradient>
    <linearGradient id="cyan-lit" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#2856D6"/>
      <stop offset="0.55" stop-color="#2FA8F0"/>
      <stop offset="1" stop-color="#B5F1FF"/>
    </linearGradient>
    <linearGradient id="cyan-shade" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#1C2F9C"/>
      <stop offset="0.55" stop-color="#2477CC"/>
      <stop offset="1" stop-color="#6FD3F5"/>
    </linearGradient>

    <!-- One petal, base at the origin, pointing up; a curved crease splits
         it into a lit half and a shaded half, giving the folded look. -->
    <path id="petal-outline" d="M 0 0 C -160 -330, -225 -800, 0 -1150 C 225 -800, 160 -330, 0 0 Z"/>
    <g id="petal-blue">
      <path d="M 0 0 C -160 -330, -225 -800, 0 -1150 C 55 -800, 45 -400, 0 0 Z" fill="url(#blue-lit)"/>
      <path d="M 0 0 C 45 -400, 55 -800, 0 -1150 C 225 -800, 160 -330, 0 0 Z" fill="url(#blue-shade)"/>
      <path d="M 0 0 C -160 -330, -225 -800, 0 -1150" fill="none" stroke="#FFFFFF" stroke-opacity="0.35" stroke-width="5"/>
    </g>
    <g id="petal-cyan">
      <path d="M 0 0 C -160 -330, -225 -800, 0 -1150 C 55 -800, 45 -400, 0 0 Z" fill="url(#cyan-lit)"/>
      <path d="M 0 0 C 45 -400, 55 -800, 0 -1150 C 225 -800, 160 -330, 0 0 Z" fill="url(#cyan-shade)"/>
      <path d="M 0 0 C -160 -330, -225 -800, 0 -1150" fill="none" stroke="#FFFFFF" stroke-opacity="0.35" stroke-width="5"/>
    </g>

    <filter id="soft-shadow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="55"/>
    </filter>
  </defs>

  <rect x="-2000" y="-2000" width="7840" height="6160" fill="url(#bg)"/>
  <rect x="-2000" y="-2000" width="7840" height="6160" fill="url(#glow)"/>
  <rect x="-2000" y="-2000" width="7840" height="6160" fill="url(#glow2)"/>

  <g transform="translate(1920 1760) scale(1.12)">
    <!-- Drop shadow under the whole bloom -->
    <g filter="url(#soft-shadow)" opacity="@SHADOW_OPACITY@" transform="translate(0 60)">
      <use xlink:href="#petal-outline" transform="rotate(-60) scale(0.8)" fill="#000016"/>
      <use xlink:href="#petal-outline" transform="rotate(60) scale(0.8)" fill="#000016"/>
      <use xlink:href="#petal-outline" transform="rotate(-41) scale(0.92)" fill="#000016"/>
      <use xlink:href="#petal-outline" transform="rotate(41) scale(0.92)" fill="#000016"/>
      <use xlink:href="#petal-outline" transform="rotate(-21)" fill="#000016"/>
      <use xlink:href="#petal-outline" transform="rotate(21)" fill="#000016"/>
    </g>

    <!-- Back petals -->
    <use xlink:href="#petal-cyan" transform="rotate(-60) scale(0.8)" opacity="0.3"/>
    <use xlink:href="#petal-blue" transform="rotate(60) scale(0.8)" opacity="0.3"/>
    <!-- Outer petals -->
    <use xlink:href="#petal-blue" transform="rotate(-41) scale(0.92)" opacity="0.62"/>
    <use xlink:href="#petal-cyan" transform="rotate(41) scale(0.92)" opacity="0.62"/>
    <!-- Main "V" -->
    <use xlink:href="#petal-blue" transform="rotate(-21)"/>
    <use xlink:href="#petal-cyan" transform="rotate(21)"/>

    <ellipse cx="0" cy="-40" rx="360" ry="200" fill="url(#core)" opacity="@CORE_OPACITY@"/>
  </g>
</svg>
