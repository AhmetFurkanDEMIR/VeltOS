#!/usr/bin/make -f

export PYBUILD_NAME = veltos-photos

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d debian/veltos-photos/usr/lib/python3/dist-packages
	cp -r veltos_photos debian/veltos-photos/usr/lib/python3/dist-packages/
	find debian/veltos-photos -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-photos debian/veltos-photos/usr/bin/veltos-photos
	install -D -m 644 data/veltos-photos.desktop \
		debian/veltos-photos/usr/share/applications/veltos-photos.desktop
	install -D -m 644 data/veltos-photos.svg \
		debian/veltos-photos/usr/share/icons/hicolor/scalable/apps/veltos-photos.svg

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
