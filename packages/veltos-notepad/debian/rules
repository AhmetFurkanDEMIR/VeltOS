#!/usr/bin/make -f

export PYBUILD_NAME = veltos-notepad

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d debian/veltos-notepad/usr/lib/python3/dist-packages
	cp -r veltos_notepad debian/veltos-notepad/usr/lib/python3/dist-packages/
	find debian/veltos-notepad -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-notepad debian/veltos-notepad/usr/bin/veltos-notepad
	install -D -m 644 data/veltos-notepad.desktop \
		debian/veltos-notepad/usr/share/applications/veltos-notepad.desktop
	install -D -m 644 data/veltos-notepad.svg \
		debian/veltos-notepad/usr/share/icons/hicolor/scalable/apps/veltos-notepad.svg

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
