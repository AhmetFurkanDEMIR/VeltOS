#!/bin/sh
set -e

# Fluent cursors as the system-wide default pointer: programs that do not
# read the desktop's cursor setting (some X11 programs, programs started as
# root) used Debian's default, Adwaita (priority 90).
if [ "$1" = configure ]; then
    update-alternatives --install /usr/share/icons/default/index.theme x-cursor-theme \
        /usr/share/icons/Fluent-cursors/cursor.theme 110
fi

# Firefox's logo fills its whole square: drawn with a margin like the
# VeltOS icons next to it (see /usr/libexec/veltos/pad-app-icon). Again
# whenever firefox-esr installs new icons (trigger on the hicolor folders).
if [ "$1" = configure ] || [ "$1" = triggered ]; then
    /usr/libexec/veltos/pad-app-icon firefox-esr || true
    /usr/libexec/veltos/pad-app-icon firefox || true
fi

#DEBHELPER#
