[Desktop Entry]
Type=Application
Name=Program Runner
Name[tr]=Program Çalıştırıcı
GenericName=Install and open .exe programs
GenericName[tr]=.exe programlarını kur ve aç
Comment=Installs and opens programs (.exe, .msi, .bat, .cmd)
Comment[tr]=Programları (.exe, .msi, .bat, .cmd) kurar ve açar
Exec=veltos-run %f
Icon=veltos-run
Terminal=false
NoDisplay=true
# Hidden from Start, but it opens .exe and .msi files (File Explorer's "Open with").
X-VeltOS-OpenWith=true
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/x-msi;application/vnd.microsoft.portable-executable;application/x-ms-ne-executable;application/x-wine-extension-msp;application/x-bat;
Categories=System;
StartupNotify=true
