#!/bin/sh
# Build-time assertions, run inside the finished chroot. Any failure here
# fails the ISO build instead of producing a silently wrong image.
set -e

fail() {
    echo "E: veltos-verify: $*" >&2
    exit 1
}

installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

# kde-plasma-desktop is spelled out in the package list (without Dolphin),
# so its main parts are checked instead of the metapackage.
for pkg in veltos-base veltos-desktop veltos-settings veltos-boot veltos-recovery veltos-calendar veltos-fluent-icons \
           veltos-explorer veltos-taskmanager veltos-disks veltos-store veltos-snip veltos-calculator veltos-archive \
           calamares-settings-veltos veltos-winapps veltos-wine-addons wine32 \
           plasma-desktop plasma-workspace kwin-wayland sddm calamares plymouth \
           live-boot live-config qemu-guest-agent; do
    installed "$pkg" || fail "required package $pkg is not installed"
done

# Third-party branding that must stay out of VeltOS.
for pkg in desktop-base calamares-settings-debian plasma-welcome xwaylandvideobridge konqueror dolphin; do
    installed "$pkg" && fail "$pkg must not be installed (non-VeltOS branding)"
done

# KDE windows and services VeltOS replaces (only VeltOS Settings opens).
for pkg in plasma-discover kup-backup kdeconnect khelpcenter kmenuedit kwalletmanager; do
    installed "$pkg" && fail "$pkg must not be installed (KDE window or service VeltOS replaces)"
done

# Packages that download non-redistributable firmware while the image is built.
for pkg in firmware-b43-installer firmware-b43legacy-installer; do
    installed "$pkg" && fail "$pkg must not be in the image (non-redistributable download)"
done

# AppArmor's profile cache for the image's kernel (8500-veltos-apparmor-cache):
# without it every boot compiles all profiles first (11 s).
[ "$(find /var/cache/apparmor -type f 2>/dev/null | wc -l)" -ge 50 ] || \
    fail "AppArmor profile cache missing (8500-veltos-apparmor-cache)"

# System identity.
for f in /usr/lib/os-release /etc/os-release; do
    id="$(. "$f" && echo "$ID")"
    [ "$id" = veltos ] || fail "$f has ID '$id', expected 'veltos'"
done
dpkg-divert --list /usr/lib/os-release | grep -q veltos-base \
    || fail "/usr/lib/os-release is not diverted by veltos-base"
# Installed systems get their boot menu entries from Debian's script behind
# the VeltOS wrapper; without it the menu had no VeltOS entry (2026-10-19).
[ -x /etc/grub.d/10_linux.dpkg-veltos ] || fail "/etc/grub.d/10_linux.dpkg-veltos (Debian's GRUB script) missing"
[ ! -e /etc/grub.d/10_linux.dpkg-new ] || fail "/etc/grub.d/10_linux.dpkg-new left behind by dpkg"
grep -q 'dpkg-veltos' /etc/grub.d/10_linux || fail "/etc/grub.d/10_linux is not the VeltOS wrapper"
for f in /etc/issue /etc/issue.net; do
    grep -q '^VeltOS ' "$f" || fail "$f does not say VeltOS"
done
[ -f /usr/lib/veltos/build-info ] || fail "/usr/lib/veltos/build-info (OS build) missing"
# Taskbar pieces of the Windows 11 layout.
for p in search taskview clock quicksettings; do
    [ -f "/usr/share/plasma/plasmoids/org.veltos.$p/metadata.json" ] \
        || fail "VeltOS taskbar widget org.veltos.$p missing"
done
[ -f /etc/calamares/branding/veltos/calamares-sidebar.qml ] \
    || fail "VeltOS installer side bar missing"
# Windows 11 changes to Plasma components must fit the Plasma in the image.
/usr/libexec/veltos/update-plasma-overrides --check \
    || fail "a VeltOS change no longer fits this Plasma version (update-plasma-overrides)"
for p in org.kde.plasma.private.systemtray org.kde.plasma.notifications \
         org.kde.plasma.devicenotifier org.kde.plasma.taskmanager; do
    [ -f "/var/lib/veltos/xdg/plasma/plasmoids/$p/.veltos-override" ] \
        || fail "VeltOS change to $p missing"
done
[ -f /var/lib/veltos/xdg/plasma/shells/org.kde.plasma.desktop/.veltos-override ] \
    || fail "Windows 11 lock screen (desktop shell override) missing"
[ -f /var/lib/veltos/xdg/kwin/aurorae/.veltos-override ] \
    || fail "window frame buttons for maximised windows (Aurorae override) missing"
# Terminal like Windows Terminal: VeltOS profile, Cascadia Mono, no toolbars,
# opaque window (update-app-names adds --notransparency).
grep -q '^DefaultProfile=VeltOS Light.profile$' /etc/xdg/konsolerc \
    || fail "VeltOS terminal profile is not the default"
fc-list | grep -q 'Cascadia Mono' || fail "terminal font Cascadia Mono missing"
for f in konsoleui.rc sessionui.rc; do
    [ -f "/usr/share/kxmlgui5/konsole/$f" ] || fail "Konsole window layout $f missing"
done
grep -q '^Exec=konsole --notransparency$' /var/lib/veltos/xdg/applications/org.kde.konsole.desktop \
    || fail "Terminal launcher without --notransparency"
# Print Screen / Windows + Shift + S belong to VeltOS Snipping Tool.
grep -q '^X-KDE-Shortcuts=Print,Meta+Shift+S$' /usr/share/applications/veltos-snip.desktop \
    || fail "Snipping Tool shortcuts missing"
grep -q '^NoDisplay=true$' /var/lib/veltos/xdg/kglobalaccel/org.kde.spectacle.desktop \
    || fail "Spectacle's global shortcuts are not switched off"
# The e-mail app is "VeltOS Mail" (product owner, 2026-10-22): Thunderbird
# under that name, in Outlook's look (autoconfig beside the program).
installed thunderbird || fail "VeltOS Mail (thunderbird) is not installed"
grep -q '^Name=VeltOS Mail$' /var/lib/veltos/xdg/applications/thunderbird.desktop || fail "Thunderbird is not named VeltOS Mail"
[ -f /usr/lib/thunderbird/veltos.cfg ] || fail "VeltOS Mail autoconfig missing"
[ -f /usr/share/veltos/mail/mail-header.css ] || fail "VeltOS Mail title band style sheet missing"
# Archives open in VeltOS Archive (KDE's Ark is not installed); RAR through 7zip-rar.
installed ark && fail "Ark must not be installed (VeltOS Archive replaces it)"
# Text files open in VeltOS Notepad (KWrite and Kate are not installed).
installed veltos-notepad || fail "VeltOS Notepad missing"
installed kwrite && fail "KWrite must not be installed (VeltOS Notepad replaces it)"
# File dialogs in the Windows 11 layout: the portal backend of File
# Explorer, chosen for Plasma sessions, and Qt's portal platform theme.
grep -q '^org.freedesktop.impl.portal.FileChooser=veltos$' /etc/xdg/xdg-desktop-portal/kde-portals.conf \
    || fail "VeltOS file dialog is not the portal's file chooser"
[ -f /usr/share/xdg-desktop-portal/portals/veltos.portal ] || fail "veltos.portal missing"
[ -f /usr/lib/x86_64-linux-gnu/qt6/plugins/platformthemes/libqxdgdesktopportal.so ] \
    || fail "Qt's portal platform theme (qt6-xdgdesktopportal-platformtheme) missing"
grep -q '^export QT_QPA_PLATFORMTHEME=xdgdesktopportal$' /etc/xdg/plasma-workspace/env/veltos-session.sh \
    || fail "the session does not use the portal file dialogs"
# Administrator password prompt: VeltOS' agent runs with the session, KDE's does not.
installed veltos-auth || fail "veltos-auth (authentication prompt) missing"
[ -L /usr/lib/systemd/user/plasma-core.target.wants/veltos-auth-agent.service ] \
    || fail "veltos-auth-agent.service is not started with the session"
[ "$(readlink /etc/systemd/user/plasma-polkit-agent.service)" = /dev/null ] \
    || fail "KDE's polkit agent service is not masked"
# Default apps: the applications cache GTK programs and Settings read.
[ -f /usr/share/applications/mimeinfo.cache ] || fail "/usr/share/applications/mimeinfo.cache missing (desktop-file-utils)"
command -v balooctl6 >/dev/null || fail "balooctl6 missing (Settings > Searching files)"
grep -q '^Indexing-Enabled=false$' /etc/xdg/baloofilerc || fail "file indexing is not off by default"
grep -q '^DisplayServer=wayland$' /usr/lib/sddm/sddm.conf.d/10-veltos.conf || fail "sign-in screen does not run on Wayland"
installed veltos-clock || fail "VeltOS Clock missing"
[ -f /etc/xdg/autostart/veltos-clock-agent.desktop ] || fail "Clock's alarm agent is not started with the session"
[ -f /usr/share/sounds/veltos/stereo/alarm-clock-elapsed.wav ] || fail "VeltOS alarm sound missing"
installed veltos-photos || fail "VeltOS Photos missing"
installed gwenview && fail "Gwenview must not be installed (VeltOS Photos replaces it)"
installed veltos-media || fail "VeltOS Media Player missing"
installed veltos-pdf || fail "VeltOS PDF Reader missing"
installed okular && fail "Okular must not be installed (VeltOS PDF Reader replaces it)"
installed veltos-office || fail "VeltOS Office missing"
installed libreoffice-l10n-tr || fail "LibreOffice's Turkish interface missing"
test -f /usr/lib/libreoffice/share/registry/veltos-office.xcd || fail "VeltOS Office settings missing"
test -e /usr/lib/libreoffice/share/template/en-US/presnt/debian-presentation.otp     && fail "Debian's presentation template is still offered"
grep -q '^Name=Word$' /var/lib/veltos/xdg/applications/libreoffice-writer.desktop     || fail "the word processor keeps LibreOffice's name in Start"
grep -q '^application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop;$'     /var/lib/veltos/xdg/applications/kde-mimeapps.list || fail ".xlsx files do not open in the spreadsheet"
grep -q '^application/pdf=veltos-pdf.desktop;$' /var/lib/veltos/xdg/applications/kde-mimeapps.list     || fail "PDF files do not open in PDF Reader"
grep -q '^video/mp4=veltos-media.desktop;$' /var/lib/veltos/xdg/applications/kde-mimeapps.list \
    || fail "videos do not open in Media Player"
grep -q '^image/jpeg=veltos-photos.desktop;$' /var/lib/veltos/xdg/applications/kde-mimeapps.list \
    || fail "pictures do not open in Photos"
grep -q '^text/plain=veltos-notepad.desktop;$' /var/lib/veltos/xdg/applications/kde-mimeapps.list \
    || fail "text files do not open in Notepad"
7z i 2>/dev/null | grep -q 'Rar5' || fail "7-Zip cannot open RAR5 archives (7zip-rar missing)"
# The calculator key opens VeltOS Calculator.
grep -q '^X-KDE-Shortcuts=Calculator$' /usr/share/applications/veltos-calculator.desktop \
    || fail "Calculator key shortcut missing"
grep -q '^IgnoreImages=false$' /etc/xdg/klipperrc || fail "clipboard does not keep pictures"
# KDE's settings windows never open: systemsettings and kcmshell6 lead to
# VeltOS Settings.
for f in /usr/bin/systemsettings /usr/bin/kcmshell6 /usr/bin/kinfocenter; do
    [ "$(readlink -f "$f")" = /usr/libexec/veltos/settings-redirect ] \
        || fail "$f does not open VeltOS Settings"
done
# Locked taskbar without KDE's widget editing, Windows' power key, scale steps.
grep -q '^plasma/allow_configure_when_locked=false$' /etc/xdg/kdeglobals \
    || fail "kiosk setting for the locked taskbar missing"
grep -q '^PowerButtonAction=8$' /etc/xdg/powerdevilrc || fail "power key does not shut down"
for h in context-menus display-scale session-fixups; do
    [ -x "/usr/libexec/veltos/$h" ] || fail "VeltOS session helper $h missing"
done
# Default wallpaper and the alternatives, light and dark.
for w in VeltOS VeltOS-Flow VeltOS-Glow VeltOS-Lake VeltOS-Nebula VeltOS-Ember VeltOS-Tide VeltOS-Dawn; do
    [ -f "/usr/share/wallpapers/$w/contents/images/1920x1080.png" ] \
        && [ -f "/usr/share/wallpapers/$w/contents/images_dark/1920x1080.png" ] \
        || fail "wallpaper $w incomplete"
done
# GTK and Firefox caption buttons, power screen.
[ -f /usr/share/themes/VeltOS/gtk-3.0/gtk.css ] || fail "VeltOS GTK theme missing"
[ -f /usr/lib/firefox-esr/veltos.cfg ] || fail "Firefox caption button set-up missing"
[ -f /usr/share/plasma/look-and-feel/org.veltos.light/contents/logout/Logout.qml ] \
    || fail "VeltOS Ctrl+Alt+Del screen missing"
! grep -q '@LOGIN_IMAGE@' /usr/share/plasma/look-and-feel/org.veltos.light/contents/logout/Logout.qml \
    || fail "Ctrl+Alt+Del screen without its background picture"
# Encrypted installs: unlimited password tries, Windows-like unlock texts.
grep -q '^  - crypttab-tries$' /etc/calamares/settings.conf \
    || fail "installer does not run the crypttab-tries job"
[ -x /usr/share/initramfs-tools/hooks/veltos-boot ] || fail "veltos-boot initramfs hook missing"

# Desktop, boot splash and installer defaults.
[ -f /usr/share/plasma/look-and-feel/org.veltos.light/metadata.json ] \
    || fail "VeltOS Plasma global theme missing"
grep -q '^LookAndFeelPackage=org.veltos.light$' /etc/xdg/kdeglobals \
    || fail "kdeglobals does not select the VeltOS global theme"
[ -f /usr/share/plasma/plasmoids/org.veltos.startmenu/metadata.json ] \
    || fail "VeltOS Start menu missing"
case "$(readlink -f /usr/share/plymouth/themes/default.plymouth)" in
    */veltos/veltos.plymouth) ;;
    *) fail "default Plymouth theme is not the VeltOS theme" ;;
esac
[ "$(plymouth-set-default-theme)" = veltos ] \
    || fail "Plymouth's configured theme is '$(plymouth-set-default-theme)', not veltos"
for initrd in /boot/initrd.img-*; do
    lsinitramfs -l "$initrd" > /tmp/veltos-initrd.list
    grep -q 'usr/share/plymouth/themes/veltos/veltos.plymouth$' /tmp/veltos-initrd.list \
        || fail "$initrd does not contain the VeltOS boot splash"
    # Plymouth's two-step plugin needs lock.png; a symlink to another theme
    # dangles in the initramfs and Plymouth falls back to the text splash.
    grep -E '^-.*usr/share/plymouth/themes/veltos/lock.png$' /tmp/veltos-initrd.list >/dev/null \
        || fail "$initrd: VeltOS splash images are missing or symlinks"
    # The password screen's font (veltos-boot initramfs hook).
    grep -q 'usr/share/fonts/opentype/inter/Inter-Regular.otf$' /tmp/veltos-initrd.list \
        || fail "$initrd does not contain the boot splash font (Inter)"
    rm -f /tmp/veltos-initrd.list
done
grep -q '^branding: veltos$' /etc/calamares/settings.conf \
    || fail "installer does not use VeltOS branding"
[ -f /etc/xdg/autostart/veltos-live-welcome.desktop ] || fail "live welcome window missing"
locale -a | grep -qx 'tr_TR.utf8' || fail "Turkish locale not compiled (needed for the language switch)"

# Windows 11 style: application style, window frames, panel theme.
[ -f /usr/share/Kvantum/VeltOS/VeltOS.kvconfig ] || fail "VeltOS Kvantum style missing"
[ -f /usr/share/aurorae/themes/VeltOS/VeltOSrc ] || fail "VeltOS window frames missing"
[ -f /usr/share/plasma/desktoptheme/VeltOS/metadata.json ] || fail "VeltOS panel theme missing"
grep -q '^widgetStyle=kvantum$' /etc/xdg/kdeglobals || fail "kdeglobals does not select Kvantum"

# Windows-familiar application names (update-app-names via dpkg trigger).
grep -q '^Name=File Explorer$' /usr/share/applications/veltos-explorer.desktop \
    || fail "VeltOS File Explorer missing"
grep -q 'inode/directory=veltos-explorer.desktop' /etc/xdg/kde-mimeapps.list \
    || fail "folders do not open in VeltOS File Explorer"
grep -q '^NoDisplay=true$' /var/lib/veltos/xdg/applications/systemsettings.desktop \
    || fail "KDE System Settings is not hidden from Start"
grep -q '^Exec=/usr/bin/veltos-explorer --filemanager1$' \
    /usr/share/dbus-1/services/org.freedesktop.FileManager1.service \
    || fail "\"show in folder\" requests do not go to File Explorer"
[ -f /usr/share/applications/veltos-settings.desktop ] || fail "VeltOS Settings missing"
grep -q '^X-KDE-Shortcuts=Ctrl+Shift+Esc$' /usr/share/applications/veltos-taskmanager.desktop \
    || fail "VeltOS Task Manager (Ctrl+Shift+Esc) missing"
[ -f /usr/share/applications/veltos-store.desktop ] || fail "VeltOS Store missing"
python3 -c 'import gi; gi.require_version("AppStream", "1.0"); from gi.repository import AppStream' \
    || fail "VeltOS Store cannot read the AppStream catalogue"
[ -f /usr/share/kwin/effects/veltostaskview/metadata.json ] || fail "VeltOS Task View missing"

# Double-clicking a Windows program opens the VeltOS runner, and Wine finds
# Mono/Gecko locally.
grep -q '^application/x-ms-dos-executable=veltos-run.desktop$' /etc/xdg/mimeapps.list \
    || fail ".exe files are not associated with veltos-run"
[ -f /usr/share/wine/mono/wine-mono-9.4.0-x86.msi ] || fail "Wine Mono missing"

# A smaller ISO without losing features (2026-10-23, docs/dev/architecture.md
# 2.23): Wine's DLLs without debug information (veltos-winapps'
# strip-wine-dlls), no extra font weights, no documentation but the
# licences, and /etc and /var stamped as up to date (no ldconfig at boot).
if x86_64-w64-mingw32-objdump -h /usr/lib/x86_64-linux-gnu/wine/x86_64-windows/kernel32.dll | grep -q '\.debug_info'; then
    fail "Wine's DLLs still carry debug information (strip-wine-dlls)"
fi
head -c 96 /usr/lib/x86_64-linux-gnu/wine/x86_64-windows/kernel32.dll | grep -q 'Wine builtin DLL' \
    || fail "stripped Wine DLLs lost their builtin mark"
for pkg in fonts-noto-extra fonts-noto-cjk-extra fonts-noto-ui-extra firmware-marvell-prestera plasma-vault; do
    installed "$pkg" && fail "$pkg must not be in the image (veltos-lean.pref.chroot)"
done
for pkg in fonts-noto-core fonts-noto-ui-core fonts-noto-cjk fonts-noto-color-emoji; do
    installed "$pkg" || fail "required font package $pkg is not installed"
done
[ -f /usr/share/doc/thunderbird/copyright ] || fail "licence files must stay in /usr/share/doc"
[ ! -e /usr/share/doc/thunderbird/changelog.Debian.gz ] || fail "documentation is not left out (dpkg.cfg.d/veltos-lean)"
[ -s /etc/.updated ] && [ -s /var/.updated ] || fail "/etc or /var not stamped (8900-veltos-update-done)"

# User-visible text audit: no launcher in the menus may mention Debian.
debian_launchers="$(grep -l -i -E '^(Name|GenericName|Comment)(\[[^]]*\])?=.*debian' \
    /usr/share/applications/*.desktop /etc/xdg/autostart/*.desktop \
    /var/lib/veltos/xdg/applications/*.desktop 2>/dev/null || true)"
[ -z "$debian_launchers" ] || fail "launchers mentioning Debian: $debian_launchers"

echo "I: veltos-verify: all checks passed"
