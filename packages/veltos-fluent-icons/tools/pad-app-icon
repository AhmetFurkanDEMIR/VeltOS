#!/usr/bin/python3
"""Give an app's own icon the margin of the VeltOS icon family.

    pad-app-icon NAME [--scale 0.84] [--dest /usr/share/icons/.Fluent-base/scalable/apps]

Some programs ship a logo that fills its whole square (Firefox's fox and
globe reach the edges), while the VeltOS icons around it on the taskbar
and in Start leave about an eighth free on each side: next to them the
logo looked too big (product owner, 2026-10-22). The program's own
picture is kept as it is (the largest PNG it installs in the hicolor
theme, embedded unchanged) and only drawn smaller in the middle of an SVG
of the program's icon name, in the Fluent themes, which are searched
before hicolor. Run by veltos-fluent-icons' postinst, also when the
program is updated (dpkg trigger on the hicolor folders).
"""

import argparse
import base64
import re
import sys
from pathlib import Path

HICOLOR = Path("/usr/share/icons/hicolor")
DEST = Path("/usr/share/icons/.Fluent-base/scalable/apps")
MARKER = "Generated by veltos-fluent-icons (pad-app-icon)"


def largest_png(name, root=HICOLOR):
    """The largest square PNG of the icon in the hicolor theme, or None."""
    best, best_size = None, 0
    for path in root.glob(f"*/apps/{name}.png"):
        match = re.fullmatch(r"(\d+)x(\d+)", path.parent.parent.name)
        if match and match.group(1) == match.group(2) and int(match.group(1)) > best_size:
            best, best_size = path, int(match.group(1))
    return best, best_size


def padded_svg(png_bytes, size, scale):
    margin = round(size * (1 - scale) / 2, 2)
    inner = round(size * scale, 2)
    data = base64.b64encode(png_bytes).decode("ascii")
    return (f'<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" '
            f'width="{size}" height="{size}" viewBox="0 0 {size} {size}">\n'
            f"  <!-- {MARKER}: the program's own icon, unchanged, with a margin. -->\n"
            f'  <image x="{margin}" y="{margin}" width="{inner}" height="{inner}" '
            f'xlink:href="data:image/png;base64,{data}"/>\n'
            f"</svg>\n")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("name")
    parser.add_argument("--scale", type=float, default=0.84)
    parser.add_argument("--dest", type=Path, default=DEST)
    parser.add_argument("--hicolor", type=Path, default=HICOLOR)
    args = parser.parse_args(argv)
    target = args.dest / f"{args.name}.svg"
    png, size = largest_png(args.name, args.hicolor)
    if png is None:
        # The program is not installed (any more): remove our copy only.
        if target.is_file() and MARKER in target.read_text(encoding="utf-8", errors="replace"):
            target.unlink()
        return 0
    if target.exists() and MARKER not in target.read_text(encoding="utf-8", errors="replace"):
        print(f"pad-app-icon: {target} is not ours; left alone", file=sys.stderr)
        return 0
    if not args.dest.is_dir():
        return 0
    text = padded_svg(png.read_bytes(), size, args.scale)
    tmp = target.with_suffix(".svg.tmp")
    tmp.write_bytes(text.encode("utf-8"))
    tmp.replace(target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
