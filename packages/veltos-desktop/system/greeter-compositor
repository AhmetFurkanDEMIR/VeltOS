#!/bin/sh
# SDDM greeter compositor: KWin on Wayland, with the arguments Plasma's own
# SDDM settings module writes (plasma-workspace 6.3). Where the display
# driver has no working OpenGL (VirtualBox; the rule is in
# needs-software-rendering), KWin's OpenGL/EGL setup fails and the greeter
# stays black: render with Mesa's llvmpipe (OpenGL in software; KWin's own
# scene keeps its effects) from the start there (the session does the same
# in veltos-session.sh).
# Elsewhere KWin renders with the GPU. The answer comes from
# sddm-virtualbox-env, which ran as root just before SDDM started and left
# /run/veltos/software-rendering when software is needed (the rule itself
# probes the render node, which the sddm user may not open); the rule is
# asked directly only when SDDM was started some other way.
if [ -e /run/veltos/software-rendering ] ||
   { [ ! -d /run/veltos ] && /usr/libexec/veltos/needs-software-rendering; }; then
    LIBGL_ALWAYS_SOFTWARE=1
    export LIBGL_ALWAYS_SOFTWARE
fi
# NVIDIA's driver and the processor's graphics: the sign-in screen, like the
# desktop, draws on the processor's graphics so the screens on both cards
# light up (kwin-gpu-order).
if [ -z "${KWIN_DRM_DEVICES:-}" ]; then
    KWIN_DRM_DEVICES="$(/usr/libexec/veltos/kwin-gpu-order 2>/dev/null)"
    if [ -n "$KWIN_DRM_DEVICES" ]; then
        export KWIN_DRM_DEVICES
    else
        unset KWIN_DRM_DEVICES
    fi
fi
exec kwin_wayland --drm --no-lockscreen --no-global-shortcuts --locale1 "$@"
