# Windows Terminal's default colour scheme "Campbell" (the colours of the
# Windows console), for the VeltOS terminal profile. Colour values from
# Windows Terminal (MIT licence), arranged as a Konsole colour scheme.
# SPDX-License-Identifier: GPL-3.0-or-later

[General]
Description=Campbell
Opacity=1
Blur=false

[Background]
Color=12,12,12

[BackgroundIntense]
Color=12,12,12

[BackgroundFaint]
Color=12,12,12

[Foreground]
Color=204,204,204

[ForegroundIntense]
Color=242,242,242

[ForegroundFaint]
Color=150,150,150

[Color0]
Color=12,12,12

[Color0Intense]
Color=118,118,118

[Color0Faint]
Color=12,12,12

[Color1]
Color=197,15,31

[Color1Intense]
Color=231,72,86

[Color1Faint]
Color=140,11,22

