[Unit]
Description=VeltOS password reset for the sign-in screen
Documentation=file:///usr/share/doc/veltos-auth/README.md

[Socket]
# The sign-in screen (SDDM's greeter, user sddm) cannot run programs; it
# asks here. Only the sddm user's connections are answered (recovery.py).
ListenStream=127.0.0.1:47824
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
