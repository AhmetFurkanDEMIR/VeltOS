#!/usr/bin/python3
"""Give applications the names Windows users look for, and hide tools that
only confuse them, without modifying other packages' files.

    update-app-names [--source /usr/share/applications] [--out DIR]

For every application in APPS that is installed, a copy of its .desktop
file with the VeltOS name (or NoDisplay=true) is written to
/var/lib/veltos/xdg/applications/. The Plasma session puts
/var/lib/veltos/xdg first in XDG_DATA_DIRS, so these copies take the place
of the originals in Start, search and the taskbar. A dpkg trigger on
/usr/share/applications re-runs this script whenever packages change those
files, so the copies never go stale.
"""

import argparse
import sys
from pathlib import Path

OUT = Path("/var/lib/veltos/xdg/applications")
HEADER = "# Generated by veltos-desktop (update-app-names) from {source}; do not edit.\n"

# desktop file -> names (English, Turkish), extra search keywords. The
# original name stays a keyword, so searching for it still works.
APPS = {
    "org.kde.konsole.desktop": ("Terminal", "Terminal", "Command Prompt;cmd;PowerShell;Komut İstemi;"),
    "org.kde.kwrite.desktop": ("Text Editor", "Metin Düzenleyici", "Notepad;Not Defteri;"),
    "org.kde.gwenview.desktop": ("Photos", "Fotoğraflar", "Pictures;Images;Resimler;"),
    "org.kde.okular.desktop": ("Document Viewer", "Belge Görüntüleyici", "PDF;Reader;Okuyucu;"),
    "org.kde.ark.desktop": ("Archive Manager", "Arşiv Yöneticisi", "zip;rar;7z;tar;Sıkıştır;"),
    # "Task Manager" is VeltOS Task Manager (veltos-taskmanager); KDE's
    # detailed monitor is Windows' Resource Monitor.
    "org.kde.plasma-systemmonitor.desktop": ("Resource Monitor", "Kaynak İzleyicisi",
                                             "System Monitor;Sensors;Sistem İzleyicisi;Algılayıcılar;"),
    "org.kde.kinfocenter.desktop": ("System Information", "Sistem Bilgisi",
                                    "About;Hardware;Donanım;Hakkında;"),
    "org.kde.partitionmanager.desktop": ("Disk Management", "Disk Yönetimi",
                                         "Partition;Format;Bölüm;Biçimlendir;"),
    "org.kde.plasma.emojier.desktop": ("Emoji", "Emoji", "Smiley;Emoticon;"),
    "firefox-esr.desktop": ("Firefox", "Firefox", "Browser;Internet;Web;Tarayıcı;"),
    # Windows' e-mail app is "Mail" ("Posta"); VeltOS uses Thunderbird.
    "thunderbird.desktop": ("Mail", "Posta", "Email;E-mail;Outlook;E-posta;"),
}

# Options added to every Exec line of an application. Konsole draws its
# window see-through (for profiles with a transparent background) and the
# application style then leaves the tab bar unpainted: other windows showed
# through it (VM, 2026-10-20). The VeltOS terminal profile is opaque.
EXEC_OPTIONS = {
    "org.kde.konsole.desktop": "--notransparency",
}

# Keys removed from the copies. Print Screen and Windows + Shift + S belong
# to VeltOS Snipping Tool (veltos-snip), not to Spectacle.
DROP_KEYS = {
    "org.kde.spectacle.desktop": ("X-KDE-Shortcuts",),
}

# Programs whose default global shortcuts are switched off: kglobalaccel
# reads $XDG_DATA_DIRS/kglobalaccel/*.desktop (the first file of a name
# wins) and skips entries with NoDisplay=true. Written to the kglobalaccel
# folder next to the applications folder.
SHORTCUTS_OFF = ["org.kde.spectacle.desktop"]
SHORTCUTS_OFF_TEXT = """# Generated by veltos-desktop (update-app-names): global shortcuts of {name}
# are off (VeltOS Snipping Tool has Print Screen and Windows + Shift + S).
[Desktop Entry]
Type=Application
Name={name}
NoDisplay=true
"""

# Hidden from Start and search (still installed; they open from other apps
# or Settings where needed): duplicates, developer tools, KDE-branded extras.
HIDE = [
    "calamares.desktop",                # the installer opens as "Install VeltOS"
    "org.kde.dolphin.desktop",          # VeltOS File Explorer (veltos-explorer) replaces it
    "org.kde.discover.desktop",         # VeltOS Store (veltos-store) replaces it
    "systemsettings.desktop",           # its pages open from VeltOS Settings
    "kdesystemsettings.desktop",        # duplicate of Settings
    "konqbrowser.desktop",              # second web browser
    "org.kde.kate.desktop",             # programmer's editor; Text Editor stays
    "org.kde.khelpcenter.desktop",      # KDE handbooks
    "org.kde.kmenuedit.desktop",
    "org.kde.kfind.desktop",            # File Explorer has search
    "org.kde.kwalletmanager.desktop",
    "org.kde.drkonqi.coredump.gui.desktop",
    "org.kde.kdeconnect.app.desktop",
    "org.kde.kdeconnect-settings.desktop",
    "org.kde.kdeconnect.nonplasma.desktop",
    "org.kde.kdeconnect.sms.desktop",
    "kvantummanager.desktop",
    "vim.desktop",
    "winetricks.desktop",               # Windows programs install via double-click
    "org.kde.spectacle.desktop",        # VeltOS Snipping Tool (veltos-snip) replaces it
    # KDE windows Windows 11 does not show in Start; renamed all the same.
    "org.kde.kinfocenter.desktop",      # opens VeltOS Settings > About (veltos-settings)
    "org.kde.plasma-systemmonitor.desktop",  # VeltOS Task Manager is the monitor
    "org.kde.plasma.emojier.desktop",   # Windows + . opens it, like Windows' emoji panel
]


def rewrite(text, source_name, names=None, hide=False, exec_options="", drop_keys=()):
    """Return the .desktop text with the main group's names replaced and/or
    NoDisplay set. Other groups ([Desktop Action ...]) are left alone,
    except that exec_options are added after the program in every Exec line
    and drop_keys are removed from every group.

    The new keys go right after the [Desktop Entry] header; every Name,
    GenericName and their translations of the main group are dropped, and
    the extra keywords (plus the original name) are added to every Keywords
    and Keywords[xx] line."""
    entries = []
    original_name = None
    group = None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            group = stripped
        elif group == "[Desktop Entry]" and "=" in stripped:
            key = stripped.split("=", 1)[0].strip()
            if key == "Name":
                original_name = stripped.split("=", 1)[1].strip()
        entries.append((group, line))
    if original_name is None:
        raise ValueError(f"{source_name}: no Name= in [Desktop Entry]")

    extra = ""
    if names:
        extra = names[2] + (original_name + ";" if original_name not in names[2].split(";") else "")
    out, has_keywords, header_at = [], False, None
    for group, line in entries:
        stripped = line.strip()
        if group == "[Desktop Entry]" and stripped == "[Desktop Entry]":
            header_at = len(out) + 1
        elif group == "[Desktop Entry]" and "=" in stripped:
            key, value = (part.strip() for part in stripped.split("=", 1))
            base = key.split("[", 1)[0]
            # GenericName goes too: shown under the name, it often repeats
            # the old brand ("KDE Text Editor").
            if names and base in ("Name", "GenericName", "X-GNOME-FullName"):
                continue
            if hide and key == "NoDisplay":
                continue
            if names and base == "Keywords":
                has_keywords |= key == "Keywords"
                separator = "" if not value or value.endswith(";") else ";"
                line = f"{key}={value}{separator}{extra}"
        if drop_keys and "=" in stripped and stripped.split("=", 1)[0].strip().split("[", 1)[0] in drop_keys:
            continue
        if exec_options and "=" in stripped and stripped.split("=", 1)[0].strip() == "Exec":
            program, _, rest = stripped.split("=", 1)[1].strip().partition(" ")
            line = f"Exec={program} {exec_options}" + (f" {rest}" if rest else "")
        out.append(line)
    added = []
    if names:
        added += [f"Name={names[0]}", f"Name[tr]={names[1]}"]
        if not has_keywords:
            added.append(f"Keywords={extra}")
    if hide:
        added.append("NoDisplay=true")
    out[header_at:header_at] = added
    return HEADER.format(source=source_name) + "\n".join(out) + "\n"


def update(source_dir, out_dir):
    out_dir.mkdir(parents=True, exist_ok=True)
    wanted = {}
    for name, names in APPS.items():
        wanted[name] = (names, False)
    for name in HIDE:
        wanted[name] = (APPS.get(name), True)
    written = []
    for name, (names, hide) in sorted(wanted.items()):
        source = source_dir / name
        target = out_dir / name
        if not source.is_file():
            target.unlink(missing_ok=True)
            continue
        try:
            text = rewrite(source.read_text(encoding="utf-8"), str(source), names, hide,
                           EXEC_OPTIONS.get(name, ""), DROP_KEYS.get(name, ()))
        except (OSError, UnicodeDecodeError, ValueError) as error:
            # One odd file must not break package installation.
            print(f"update-app-names: skipping {source}: {error}", file=sys.stderr)
            target.unlink(missing_ok=True)
            continue
        if not target.exists() or target.read_text(encoding="utf-8") != text:
            tmp = target.with_suffix(".tmp")
            tmp.write_text(text, encoding="utf-8")
            tmp.replace(target)
        written.append(name)
    # Overrides for applications that are no longer listed.
    for stale in out_dir.glob("*.desktop"):
        if stale.name not in wanted:
            stale.unlink()
    update_shortcuts(source_dir, out_dir.parent / "kglobalaccel")
    return written


def update_shortcuts(source_dir, folder):
    """Switch off the global shortcuts of SHORTCUTS_OFF (installed ones)."""
    folder.mkdir(parents=True, exist_ok=True)
    for name in SHORTCUTS_OFF:
        target = folder / name
        if (source_dir / name).is_file():
            target.write_text(SHORTCUTS_OFF_TEXT.format(name=name.removesuffix(".desktop")), encoding="utf-8")
        else:
            target.unlink(missing_ok=True)
    for stale in folder.glob("*.desktop"):
        if stale.name not in SHORTCUTS_OFF and stale.read_text(encoding="utf-8").startswith("# Generated by veltos"):
            stale.unlink()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--source", type=Path, default=Path("/usr/share/applications"))
    parser.add_argument("--out", type=Path, default=OUT)
    args = parser.parse_args(argv)
    update(args.source, args.out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
