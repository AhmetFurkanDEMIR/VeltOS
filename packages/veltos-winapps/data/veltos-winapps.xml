<?xml version="1.0" encoding="UTF-8"?>
<!-- VeltOS: .cmd files are Windows batch files like .bat (shared-mime-info
     2.4 knows only *.bat). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-bat">
    <glob pattern="*.cmd"/>
  </mime-type>
</mime-info>
