#!/bin/sh
# live-build configuration for the VeltOS live/install ISO.
# Run through `lb config` (build/scripts/build-iso.sh does this); the options
# are explained in docs/dev/architecture.md and lb_config(1).
set -e

VELTOS_VERSION="${VELTOS_VERSION:-0.1.0-dev}"
DEBIAN_MIRROR="${VELTOS_DEBIAN_MIRROR:-http://deb.debian.org/debian/}"
SECURITY_MIRROR="${VELTOS_SECURITY_MIRROR:-http://deb.debian.org/debian-security/}"

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures amd64 \
	--linux-flavours amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--security true \
	--updates true \
	--backports false \
	--apt-recommends true \
	--apt-source-archives false \
	--debian-installer none \
	--binary-images iso-hybrid \
	--bootloaders "grub-pc,grub-efi" \
	--uefi-secure-boot enable \
	--firmware-chroot false \
	--firmware-binary false \
	--chroot-squashfs-compression-type zstd \
	--chroot-squashfs-compression-level 19 \
	--memtest none \
	--checksums sha256 \
	--zsync false \
	--image-name "veltos-${VELTOS_VERSION}" \
	--iso-application "VeltOS" \
	--iso-publisher "VeltOS Project" \
	--iso-volume "VeltOS ${VELTOS_VERSION} amd64" \
	--bootappend-live "boot=live nocomponents=tzdata,gdm3,kdm,lightdm,lxdm,nodm,slim,xinit,apport,gnome-panel-data,gnome-power-manager,gnome-screensaver,kaboom,ssl-cert,anacron,xserver-xorg,openssh-server,xfce4-panel,xscreensaver,broadcom-sta quiet splash loglevel=3 systemd.show_status=false rd.systemd.show_status=false udev.log_level=3 rd.udev.log_level=3 vt.global_cursor_default=0 username=velt hostname=veltos user-fullname=Velt" \
	--mirror-bootstrap "${DEBIAN_MIRROR}" \
	--mirror-chroot "${DEBIAN_MIRROR}" \
	--mirror-chroot-security "${SECURITY_MIRROR}" \
	--mirror-binary "http://deb.debian.org/debian/" \
	--mirror-binary-security "http://deb.debian.org/debian-security/" \
	"${@}"
