<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- veltos-msi-ec: reading the MSI laptop's EC firmware version only reads
     (no password for the signed-in user); building and loading a driver is
     an administrator's change, as on Windows. -->
<policyconfig>
  <vendor>VeltOS</vendor>
  <action id="org.veltos.msi-ec.firmware">
    <description>Read the MSI laptop's firmware version</description>
    <description xml:lang="tr">MSI dizüstü bilgisayarın üretici yazılımı sürümünü oku</description>
    <message>Authentication is required to read the laptop's firmware version</message>
    <message xml:lang="tr">Dizüstü bilgisayarın üretici yazılımı sürümünü okumak için kimlik doğrulaması gerekiyor</message>
    <icon_name>veltos-lighting</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/veltos/msi-ec-firmware</annotate>
  </action>
  <action id="org.veltos.msi-ec.driver">
    <description>Install the MSI keyboard light driver</description>
    <description xml:lang="tr">MSI klavye ışığı sürücüsünü yükle</description>
    <message>Authentication is required to install a driver</message>
    <message xml:lang="tr">Sürücü yüklemek için kimlik doğrulaması gerekiyor</message>
    <icon_name>veltos-lighting</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/veltos/msi-ec-driver</annotate>
  </action>
</policyconfig>
