#!/usr/bin/python3
"""VeltOS: KDE's settings programs open VeltOS Settings instead.

Installed as /usr/bin/systemsettings, /usr/bin/kcmshell6,
/usr/bin/kinfocenter and /usr/bin/keditfiletype (KDE's are diverted to
*.kde by the veltos-settings package, and only root may run those: users
cannot reach KDE's settings window even from a terminal; product owner,
2026-10-22), so every "Configure" link in KDE programs, the Start menu and
KRunner opens the matching VeltOS Settings page, never KDE's own settings
window (product owner's rule). Unknown modules open VeltOS Settings' Home;
KDE Info Center without a module opens About; KDE's file type editor
opens Default apps.

    systemsettings [MODULE] [--args ...]
    kcmshell6 [options] MODULE [--args ...]
    kinfocenter [MODULE]
"""
import os
import sys

# Options of systemsettings / kcmshell6 that take a value.
WITH_VALUE = {"--args", "--icon", "--caption", "--platform", "--qwindowtitle", "--qwindowicon",
              "--desktopfile", "--highlight"}


def module(argv):
    skip = False
    for arg in argv:
        if skip:
            skip = False
            continue
        if arg in WITH_VALUE:
            skip = True
            continue
        if arg.startswith("-"):
            continue
        return arg
    return ""


def main():
    program = os.path.basename(sys.argv[0])
    name = module(sys.argv[1:])
    if program == "keditfiletype":
        name = "defaultapps"            # its argument is a file type, not a page
    elif not name and program == "kinfocenter":
        name = "about"
    try:
        from veltos_settings.catalog import page_for_module
        page = page_for_module(name)
    except Exception:  # never fall back to KDE's window
        page = "home"
    os.execvp("veltos-settings", ["veltos-settings", page])


if __name__ == "__main__":
    main()
