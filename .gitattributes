# Everything in this repo is consumed by Linux tooling (live-build, dpkg,
# shell scripts), so force LF line endings even on Windows checkouts.
* text=auto eol=lf

*.png binary
*.jpg binary
*.iso binary
*.deb binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
