[Unit]
Description=VeltOS password reset request from the sign-in screen
Documentation=file:///usr/share/doc/veltos-auth/README.md

[Service]
ExecStart=/usr/libexec/veltos/password-recovery serve
StandardInput=socket
StandardOutput=socket
StandardError=journal
# The drive is mounted in a mount namespace of its own (nobody else sees
# it); no home folders are needed.
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
TimeoutStopSec=60
