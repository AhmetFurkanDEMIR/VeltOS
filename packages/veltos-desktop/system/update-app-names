                   "# Do not edit; users choose in Settings > Apps > Default apps.\n")


def defaults_text(source_dir):
    """The [Default Applications] of the installed VeltOS apps, or ""."""
    chosen = {}
    for desktop, types in DEFAULT_APPS:
        if not (source_dir / desktop).is_file():
            continue
        for mime in types:
            chosen.setdefault(mime, desktop)
    if not chosen:
        return ""
    lines = [f"{mime}={desktop};" for mime, desktop in sorted(chosen.items())]
    return DEFAULTS_HEADER + "[Default Applications]\n" + "\n".join(lines) + "\n"


def update_defaults(source_dir, out_dir):
    target = out_dir / DEFAULTS_FILE
    text = defaults_text(source_dir)
    if not text:
        target.unlink(missing_ok=True)
    elif not target.exists() or target.read_text(encoding="utf-8") != text:
        tmp = target.with_suffix(".tmp")
        tmp.write_text(text, encoding="utf-8")
        tmp.replace(target)


def update_shortcuts(source_dir, folder):
    """Switch off the global shortcuts of SHORTCUTS_OFF (installed ones)."""
    folder.mkdir(parents=True, exist_ok=True)
    for name, reason in SHORTCUTS_OFF.items():
        target = folder / name
        if (source_dir / name).is_file() or (source_dir.parent / "kglobalaccel" / name).is_file():
            target.write_text(SHORTCUTS_OFF_TEXT.format(name=name.removesuffix(".desktop"), reason=reason),
                              encoding="utf-8")
        else:
            target.unlink(missing_ok=True)
    for stale in folder.glob("*.desktop"):
        if stale.name not in SHORTCUTS_OFF and stale.read_text(encoding="utf-8").startswith("# Generated by veltos"):
            stale.unlink()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--source", type=Path, default=Path("/usr/share/applications"))
    parser.add_argument("--out", type=Path, default=OUT)
    args = parser.parse_args(argv)
    update(args.source, args.out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
