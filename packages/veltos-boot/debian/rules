#!/usr/bin/make -f

# The boot splash, keyboard layout and password screen live in the initramfs.
# dh_installinitramfs adds the update-initramfs trigger for the hook in
# usr/share/initramfs-tools/hooks, which rebuilds it after install/upgrade.
%:
	dh $@

override_dh_auto_build:
	python3 tools/build-assets.py --out build-assets

override_dh_auto_test:
	python3 -m unittest discover -s tests -v

override_dh_auto_clean:
	rm -rf build-assets

# Checks on the installed tree (files are copied by dh_install).
GRUB_THEME = $(CURDIR)/debian/veltos-boot/usr/share/grub/themes/veltos
execute_after_dh_install:
	test $$(ls $(GRUB_THEME)/inter-*.pf2 | wc -l) -eq 6
	test $$(ls $(GRUB_THEME)/select_*.png | wc -l) -eq 9
	grep -qx 'Theme=veltos' $(CURDIR)/debian/veltos-boot/usr/share/plymouth/plymouthd.defaults
	# Real files: the initramfs has no other theme to link to.
	test -z "$$(find $(CURDIR)/debian/veltos-boot/usr/share/plymouth -type l)"
	test -s $(CURDIR)/debian/veltos-boot/usr/share/plymouth/themes/veltos/lock.png
	test -f $(CURDIR)/debian/veltos-boot/usr/lib/systemd/system/sddm.service.d/veltos-plymouth.conf
	# The GRUB wrapper must not be a conffile (see debian/veltos-boot.postinst).
	test ! -e $(CURDIR)/debian/veltos-boot/etc/grub.d/10_linux
	test -x $(CURDIR)/debian/veltos-boot/usr/lib/veltos-boot/grub.d/10_linux
	# Password screen font and texts (initramfs hook).
	test -x $(CURDIR)/debian/veltos-boot/usr/share/initramfs-tools/hooks/veltos-boot
	test -x $(CURDIR)/debian/veltos-boot/usr/lib/veltos-boot/unlock-texts
	# Start-up screen at the screen's resolution.
	test -x $(CURDIR)/debian/veltos-boot/usr/libexec/veltos-boot/boot-resolution
	test -x $(CURDIR)/debian/veltos-boot/usr/libexec/veltos-boot/boot-resolution-sync
	test -L $(CURDIR)/debian/veltos-boot/usr/lib/systemd/user/plasma-workspace.target.wants/veltos-boot-resolution.service
	test -f $(CURDIR)/debian/veltos-boot/usr/share/polkit-1/actions/org.veltos.boot.policy
