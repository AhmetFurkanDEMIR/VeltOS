#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	test -d upstream/Kvantum || (echo "upstream/ missing: run build/scripts/fetch-upstream.py" >&2; exit 1)
	python3 tools/build-assets.py --fluent upstream --out build-assets

override_dh_auto_test:
	python3 -m unittest discover -s tests -v

override_dh_auto_clean:
	rm -rf build-assets
