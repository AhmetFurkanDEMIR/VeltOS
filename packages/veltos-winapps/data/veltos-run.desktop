[Desktop Entry]
Type=Application
Name=Windows Program Runner
Name[tr]=Windows Programı Çalıştırıcı
GenericName=Install and open Windows programs
GenericName[tr]=Windows programlarını kur ve aç
Comment=Installs and opens Windows programs (.exe, .msi, .bat, .cmd)
Comment[tr]=Windows programlarını (.exe, .msi, .bat, .cmd) kurar ve açar
Exec=veltos-run %f
Icon=veltos-logo
Terminal=false
NoDisplay=true
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/x-msi;application/vnd.microsoft.portable-executable;application/x-ms-ne-executable;application/x-wine-extension-msp;application/x-bat;
Categories=System;
StartupNotify=true
