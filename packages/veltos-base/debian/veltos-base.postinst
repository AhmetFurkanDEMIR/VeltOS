#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # Not conffiles of this package: the paths belong to base-files, whose
    # files were diverted in preinst.
    install -m 644 /usr/share/veltos-base/issue /etc/issue
    install -m 644 /usr/share/veltos-base/issue.net /etc/issue.net
fi

#DEBHELPER#
