#!/usr/bin/make -f

export PYBUILD_NAME = veltos-explorer

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d debian/veltos-explorer/usr/lib/python3/dist-packages
	cp -r veltos_explorer debian/veltos-explorer/usr/lib/python3/dist-packages/
	find debian/veltos-explorer -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-explorer debian/veltos-explorer/usr/bin/veltos-explorer
	install -D -m 644 data/veltos-explorer.desktop \
		debian/veltos-explorer/usr/share/applications/veltos-explorer.desktop
	install -D -m 644 data/kde-mimeapps.list debian/veltos-explorer/etc/xdg/kde-mimeapps.list

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
