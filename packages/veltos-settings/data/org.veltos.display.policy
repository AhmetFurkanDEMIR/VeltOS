<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- veltos-settings: the user of the active session looks for monitors
     that are plugged in but not shown (Settings > Display > Detect), as on
     Windows, without a password. The helper only asks the kernel to probe
     the graphics cards' connectors again. -->
<policyconfig>
  <vendor>VeltOS</vendor>
  <action id="org.veltos.display.detect">
    <description>Detect other displays</description>
    <description xml:lang="tr">Diğer ekranları algıla</description>
    <message>Authentication is required to detect other displays</message>
    <message xml:lang="tr">Diğer ekranları algılamak için kimlik doğrulaması gerekiyor</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/veltos/display-detect</annotate>
  </action>
</policyconfig>
