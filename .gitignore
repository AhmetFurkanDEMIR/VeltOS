/out/

# Debian package build artefacts
/packages/*/build-assets/
/packages/*/upstream/
/packages/*/debian/.debhelper/
/packages/*/debian/debhelper-build-stamp
/packages/*/debian/files
/packages/*/debian/*.substvars
/packages/*/debian/*/
!/packages/*/debian/source/

__pycache__/
*.pyc
