# VeltOS installer branding.
---
componentName:  veltos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 1100px,720px
windowPlacement: center

# Windows 11 style side bar (logo and steps) and buttons, written in QML
# (calamares-sidebar.qml, calamares-navigation.qml); every other control
# is styled by stylesheet.qss.
sidebar: qml
navigation: qml

strings:
    productName:         VeltOS
    shortProductName:    VeltOS
    version:             0.1
    shortVersion:        0.1
    versionedName:       VeltOS 0.1
    shortVersionedName:  VeltOS 0.1
    # Used for the firmware boot entry name only if efiBootloaderId is unset
    # (it is set; see modules/bootloader.conf).
    bootloaderEntryName: VeltOS

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI: 2

# Used by Calamares parts that are not QML (light, like the QML side bar).
style:
   SidebarBackground:        "#EBEFF7"
   SidebarText:              "#1B1D24"
   SidebarTextCurrent:       "#1B1D24"
   SidebarBackgroundCurrent: "#DCE3F3"
