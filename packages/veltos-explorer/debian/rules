#!/usr/bin/make -f

export PYBUILD_NAME = veltos-explorer

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d debian/veltos-explorer/usr/lib/python3/dist-packages
	cp -r veltos_explorer debian/veltos-explorer/usr/lib/python3/dist-packages/
	find debian/veltos-explorer -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-explorer debian/veltos-explorer/usr/bin/veltos-explorer
	install -D -m 644 data/veltos-explorer.desktop \
		debian/veltos-explorer/usr/share/applications/veltos-explorer.desktop
	# App icon (VeltOS artwork, Windows 11 style).
	install -D -m 644 data/veltos-explorer.svg \
		debian/veltos-explorer/usr/share/icons/hicolor/scalable/apps/veltos-explorer.svg
	install -D -m 644 data/kde-mimeapps.list debian/veltos-explorer/etc/xdg/kde-mimeapps.list
	# Windows drives: ntfs-3g first, Windows file names, read-only when
	# Windows did not shut down; administrators open internal drives.
	install -D -m 644 data/udisks2-mount_options.conf debian/veltos-explorer/etc/udisks2/mount_options.conf
	install -D -m 644 data/50-veltos-drives.rules debian/veltos-explorer/usr/share/polkit-1/rules.d/50-veltos-drives.rules
	# "Show in folder" requests of other programs (D-Bus activation).
	install -D -m 644 data/org.freedesktop.FileManager1.service \
		debian/veltos-explorer/usr/share/dbus-1/services/org.freedesktop.FileManager1.service
	# File dialogs of other programs: the file chooser portal backend
	# (portal.py), chosen for Plasma sessions by kde-portals.conf.
	install -D -m 644 data/org.freedesktop.impl.portal.desktop.veltos.service \
		debian/veltos-explorer/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.veltos.service
	install -D -m 644 data/veltos.portal debian/veltos-explorer/usr/share/xdg-desktop-portal/portals/veltos.portal
	install -D -m 644 data/kde-portals.conf debian/veltos-explorer/etc/xdg/xdg-desktop-portal/kde-portals.conf

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
