#!/usr/bin/make -f

PKG = debian/veltos-recovery
UNITS = $(PKG)/usr/lib/systemd/system

%:
	dh $@ --with python3

override_dh_auto_build:

override_dh_auto_install:
	install -d $(PKG)/usr/lib/python3/dist-packages
	cp -r veltos_recovery $(PKG)/usr/lib/python3/dist-packages/
	find $(PKG) -name __pycache__ -prune -exec rm -rf {} +
	install -D -m 755 bin/veltos-recovery $(PKG)/usr/bin/veltos-recovery
	install -D -m 644 branding/veltos-logo.svg $(PKG)/usr/share/veltos-recovery/veltos-logo.svg
	for f in run-recovery boot-ok boot-failed safe-graphics; do \
		install -D -m 755 system/$$f $(PKG)/usr/lib/veltos-recovery/$$f; done
	for f in veltos-recovery.target veltos-recovery.service veltos-boot-ok.service veltos-boot-failed.service \
	         veltos-safe-graphics.service; do \
		install -D -m 644 system/$$f $(UNITS)/$$f; done
	# Wired statically: no unit is enabled or started by the maintainer scripts.
	install -d $(UNITS)/graphical.target.wants $(UNITS)/emergency.target.wants $(UNITS)/rescue.target.wants
	ln -s ../veltos-boot-ok.service $(UNITS)/graphical.target.wants/veltos-boot-ok.service
	ln -s ../veltos-boot-failed.service $(UNITS)/emergency.target.wants/veltos-boot-failed.service
	ln -s ../veltos-boot-failed.service $(UNITS)/rescue.target.wants/veltos-boot-failed.service
	install -D -m 644 system/sddm-veltos-recovery.conf $(UNITS)/sddm.service.d/veltos-recovery.conf
	install -D -m 644 system/journald-veltos-recovery.conf \
		$(PKG)/usr/lib/systemd/journald.conf.d/veltos-recovery.conf
	install -D -m 644 README.md $(PKG)/usr/share/doc/veltos-recovery/README.md

# The units are wired by the symlinks above; nothing to enable or start.
override_dh_installsystemd:

override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
