# Keep Debian's and KDE's own branding out of the image:
#  * desktop-base installs Debian wallpapers, a Plasma global theme and
#    GRUB/Plymouth themes; it arrives only through sddm's Recommends on
#    sddm-theme-debian-breeze, which sddm-theme-breeze satisfies instead;
#  * calamares-settings-debian is replaced by calamares-settings-veltos;
#  * plasma-welcome shows KDE community pages on first login (a VeltOS
#    welcome app is planned).
# If a hard dependency ever requires one of them, the build fails and shows why.
Package: desktop-base sddm-theme-debian-* calamares-settings-debian plasma-welcome
Pin: release a=*
Pin-Priority: -1

# Never build downloads of non-redistributable firmware into the image.
Package: firmware-b43-installer firmware-b43legacy-installer
Pin: release a=*
Pin-Priority: -1

# xwaylandvideobridge (recommended by kwin-wayland) lets X11 programs record
# Wayland windows; it runs at every sign-in and showed a technical "Wayland
# to X11 Video bridge" item in the taskbar's hidden icons (VM, 2026-10-19).
Package: xwaylandvideobridge
Pin: release a=*
Pin-Priority: -1

# Konqueror (recommended by kde-baseapps) became the default browser of the
# live session (first pinned app in Start) and preloads itself at every
# sign-in; VeltOS' browser is Firefox.
Package: konqueror
Pin: release a=*
Pin-Priority: -1

# Dolphin, KDE's file manager: VeltOS has one file manager, File Explorer
# (veltos-explorer), which also answers "show in folder" requests
# (org.freedesktop.FileManager1).
Package: dolphin
Pin: release a=*
Pin-Priority: -1
