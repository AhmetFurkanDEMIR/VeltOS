#!/usr/bin/python3
"""Windows 11 look for a few Plasma components without forking them.

    update-plasma-overrides [--source /usr/share/plasma/plasmoids]
                            [--specs /usr/share/veltos/plasma-overrides]
                            [--out /var/lib/veltos/xdg/plasma/plasmoids] [--check]

Each spec (<plugin id>.json) lists exact text replacements in the QML of
one installed Plasma package, for example "the hidden tray icons have no
labels". This script copies the installed package to --out, applies the
replacements and checks that every one matched exactly as often as
expected. The Plasma session puts /var/lib/veltos/xdg first in
XDG_DATA_DIRS, so Plasma loads the changed copy instead of the original.

If Plasma is updated and a replacement no longer matches, the copy is
removed and Plasma's own version is used: the component then looks like
KDE's, but it keeps working. A dpkg trigger on /usr/share/plasma/plasmoids
re-runs this script after every Plasma update. --check reports problems
with a non-zero exit code (used by the image build).
"""

import argparse
import json
import shutil
import sys
from pathlib import Path

SOURCE = Path("/usr/share/plasma/plasmoids")
SPECS = Path("/usr/share/veltos/plasma-overrides")
OUT = Path("/var/lib/veltos/xdg/plasma/plasmoids")
MARKER = ".veltos-override"


def apply_spec(spec, source_dir, out_dir):
    """Write the changed copy of one package; returns a problem or None."""
    plugin = spec["plugin"]
    src = source_dir / plugin
    dest = out_dir / plugin
    tmp = out_dir / f".{plugin}.tmp"
    if not src.is_dir():
        shutil.rmtree(dest, ignore_errors=True)
        return f"{plugin}: not installed"
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, symlinks=True)
    for number, change in enumerate(spec["replacements"], 1):
        path = tmp / change["file"]
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            shutil.rmtree(tmp, ignore_errors=True)
            shutil.rmtree(dest, ignore_errors=True)
            return f"{plugin}: {change['file']} missing"
        expected = change.get("count", 1)
        found = text.count(change["old"])
        if found != expected:
            shutil.rmtree(tmp, ignore_errors=True)
            shutil.rmtree(dest, ignore_errors=True)
            return (f"{plugin}: replacement {number} ({change['why']}) matched {found} times "
                    f"in {change['file']}, expected {expected}; using Plasma's own version")
        path.write_text(text.replace(change["old"], change["new"]), encoding="utf-8")
    (tmp / MARKER).write_text(f"Generated by veltos-desktop from {src}; do not edit.\n",
                              encoding="utf-8")
    shutil.rmtree(dest, ignore_errors=True)
    tmp.rename(dest)
    return None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--source", type=Path, default=SOURCE)
    parser.add_argument("--specs", type=Path, default=SPECS)
    parser.add_argument("--out", type=Path, default=OUT)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args(argv)

    args.out.mkdir(parents=True, exist_ok=True)
    specs = [json.loads(p.read_text(encoding="utf-8")) for p in sorted(args.specs.glob("*.json"))]
    wanted = {spec["plugin"] for spec in specs}
    # Copies whose spec is gone (package update) are removed.
    for old in args.out.iterdir():
        if old.is_dir() and (old / MARKER).exists() and old.name not in wanted:
            shutil.rmtree(old)
    problems = [p for p in (apply_spec(spec, args.source, args.out) for spec in specs) if p]
    for problem in problems:
        print(f"update-plasma-overrides: {problem}", file=sys.stderr)
    return 1 if problems and args.check else 0


if __name__ == "__main__":
    sys.exit(main())
