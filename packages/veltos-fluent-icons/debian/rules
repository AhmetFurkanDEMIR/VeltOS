#!/usr/bin/make -f

ICONS = $(CURDIR)/debian/veltos-fluent-icons/usr/share/icons
# VeltOS's own icons in branding/ that replace Fluent's of the same name.
VELTOS_ICONS = computer user-trash user-trash-full folder inode-directory user-desktop \
	folder-download folder-documents folder-pictures folder-music folder-videos drive-harddisk \
	utilities-terminal org.kde.konsole konsole terminal

%:
	dh $@

override_dh_auto_build:
	test -f upstream/install.sh || (echo "upstream/ missing: run build/scripts/fetch-upstream.py" >&2; exit 1)

override_dh_auto_install:
	mkdir -p $(ICONS)
	bash upstream/install.sh --dest $(ICONS) standard
	# Fall back to Breeze (not only hicolor) for icons Fluent lacks.
	sed -i 's/^Inherits=.*/Inherits=breeze-dark,hicolor/' $(ICONS)/Fluent-dark/index.theme
	sed -i 's/^Inherits=.*/Inherits=breeze,hicolor/' $(ICONS)/Fluent/index.theme $(ICONS)/Fluent-light/index.theme
	# Fluent cursors (Windows 11 style), prebuilt by upstream.
	cp -a upstream/cursors/dist $(ICONS)/Fluent-cursors
	cp -a upstream/cursors/dist-dark $(ICONS)/Fluent-dark-cursors
	# Target of the x-cursor-theme alternative (see the postinst).
	printf '[Icon Theme]\nInherits=Fluent-cursors\n' > $(ICONS)/Fluent-cursors/cursor.theme
	# Branding: the "start here"/distributor icons show the VeltOS logo, and
	# icons drawn as the Microsoft Windows logo (upstream's Wine icons) are
	# removed so Breeze's neutral icons are used instead.
	find $(ICONS) -type f \( -name 'start-here.svg' -o -name 'start-here-symbolic.svg' \
		-o -name 'distributor-logo.svg' -o -name 'distributor-logo-symbolic.svg' \) \
		-exec cp branding/veltos-logo.svg {} \;
	find $(ICONS) -type f \( -name 'wine.svg' -o -name 'wine-winecfg.svg' -o -name 'windows.svg' \) -delete
	# "This PC", the Recycle Bin, folders, the local disk and the terminal in the look of
	# Windows 11 (VeltOS artwork, branding/, tools/draw-icons.py), at all
	# sizes and in the dark theme too. Many of Fluent's are symbolic links
	# (folder -> default-folder.svg): those are replaced by the file. The
	# 16, 22 and 24 px folders get the drawings made for small sizes
	# (branding/small/) where there is one.
	for name in $(VELTOS_ICONS); do \
		find $(ICONS) \( -type f -o -type l \) \( -name "$$name.svg" -o -name "$$name-dark.svg" \) \
			-exec sh -c 'src="$$2"; case "$$1" in */16/*|*/16@*/*|*/22/*|*/22@*/*|*/24/*|*/24@*/*) \
				[ -f "$$3" ] && src="$$3";; esac; rm -f "$$1" && cp "$$src" "$$1"' \
				sh {} branding/$$name.svg branding/small/$$name.svg \; ; \
	done
	# "Close" in menus, dialogs and tabs: a thin monochrome cross like Windows
	# 11, not Fluent's red disc (light and dark theme colours).
	for name in window-close dialog-close tab-close; do \
		find $(ICONS) \( -type f -o -type l \) -path '*/actions/*' -name "$$name.svg" \
			-exec sh -c 'case "$$1" in *-dark*) src=branding/close-dark.svg;; *) src=branding/close.svg;; esac; \
				rm -f "$$1" && cp "$$src" "$$1"' sh {} \; ; \
	done
	# Yellow folders like Windows 11 (Fluent's are blue), coloured at all sizes.
	python3 tools/recolour-folders.py $(ICONS)
	# Drop dangling symlinks (a few from upstream, plus links to removed files).
	find $(ICONS) -xtype l -delete
	# Icon caches are generated on the target system by dpkg triggers.
	find $(ICONS) -name icon-theme.cache -delete

# Checks on the installed tree (dh_auto_test runs before dh_auto_install).
execute_after_dh_auto_install:
	grep -q '^Inherits=breeze-dark,hicolor' $(ICONS)/Fluent-dark/index.theme
	test -z "$$(find $(ICONS) -xtype l)"
	for app in org.kde.dolphin firefox-esr org.kde.konsole systemsettings; do \
		test -e $(ICONS)/Fluent/scalable/apps/$$app.svg || exit 1; done
	test -f $(ICONS)/Fluent-cursors/index.theme
	test -e $(ICONS)/Fluent-cursors/cursors/default
	grep -qx 'Inherits=Fluent-cursors' $(ICONS)/Fluent-cursors/cursor.theme
	for f in $$(find -L $(ICONS)/Fluent-dark -name 'start-here.svg'); do cmp -s $$f branding/veltos-logo.svg || exit 1; done
	test -z "$$(find -L $(ICONS) -name 'wine.svg')"
	for name in $(VELTOS_ICONS); do \
		test -n "$$(find -L $(ICONS)/Fluent -name "$$name.svg")" || exit 1; \
		for f in $$(find -L $(ICONS)/Fluent $(ICONS)/Fluent-dark -name "$$name.svg"); do \
			cmp -s $$f branding/$$name.svg || cmp -s $$f branding/small/$$name.svg || exit 1; done; \
	done
	! grep -rqi 'da4453' $(ICONS)/.Fluent-base/16/actions/window-close.svg $(ICONS)/.Fluent-dark-base/22/actions/tab-close.svg
	! grep -qi '198ee6' $(ICONS)/.Fluent-base/scalable/places/default-folder.svg
	grep -q 'FFC83D' $(ICONS)/.Fluent-base/scalable/apps/file-manager.svg
