def rewrite(text, source_name, names=None, hide=False, exec_options="", drop_keys=(), exec_replace=None,
            icon=""):
    """Return the .desktop text with the main group's names replaced and/or
    NoDisplay set. Other groups ([Desktop Action ...]) are left alone,
    except that exec_options are added after the program in every Exec line,
    drop_keys are removed from every group, and exec_replace = (old
    program, new program) replaces the program in every Exec line (an
    action's line without arguments gets --blank: it opens a document).

    The new keys go right after the [Desktop Entry] header; every Name,
    GenericName and their translations of the main group are dropped, and
    the extra keywords (plus the original name) are added to every Keywords
    and Keywords[xx] line."""
    entries = []
    original_name = None
    group = None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            group = stripped
        elif group == "[Desktop Entry]" and "=" in stripped:
            key = stripped.split("=", 1)[0].strip()
            if key == "Name":
                original_name = stripped.split("=", 1)[1].strip()
        entries.append((group, line))
    if original_name is None:
        raise ValueError(f"{source_name}: no Name= in [Desktop Entry]")

    extra = ""
    if names:
        extra = names[2] + (original_name + ";" if original_name not in names[2].split(";") else "")
    out, has_keywords, header_at = [], False, None
    for group, line in entries:
        stripped = line.strip()
        if group == "[Desktop Entry]" and stripped == "[Desktop Entry]":
            header_at = len(out) + 1
        elif group == "[Desktop Entry]" and "=" in stripped:
            key, value = (part.strip() for part in stripped.split("=", 1))
            base = key.split("[", 1)[0]
            # GenericName goes too: shown under the name, it often repeats
            # the old brand ("KDE Text Editor").
            if names and base in ("Name", "GenericName", "X-GNOME-FullName"):
                continue
            if hide and key == "NoDisplay":
                continue
            if icon and key == "Icon":
                continue
            if names and base == "Keywords":
                has_keywords |= key == "Keywords"
                separator = "" if not value or value.endswith(";") else ";"
                line = f"{key}={value}{separator}{extra}"
        if drop_keys and "=" in stripped and stripped.split("=", 1)[0].strip().split("[", 1)[0] in drop_keys:
            continue
        if exec_replace and "=" in stripped and stripped.split("=", 1)[0].strip() == "Exec":
            command = stripped.split("=", 1)[1].strip()
            old, new = exec_replace
            if command == old or command.startswith(old + " "):
                rest = command[len(old):].strip()
                if not rest and group != "[Desktop Entry]":
                    rest = "--blank"
                line = f"Exec={new}" + (f" {rest}" if rest else "")
        elif exec_options and "=" in stripped and stripped.split("=", 1)[0].strip() == "Exec":
            program, _, rest = stripped.split("=", 1)[1].strip().partition(" ")
            line = f"Exec={program} {exec_options}" + (f" {rest}" if rest else "")
        out.append(line)
    added = []
    if names:
        added += [f"Name={names[0]}", f"Name[tr]={names[1]}"]
        if not has_keywords:
            added.append(f"Keywords={extra}")
    if hide:
        added.append("NoDisplay=true")
    if icon:
        added.append(f"Icon={icon}")
    out[header_at:header_at] = added
    return HEADER.format(source=source_name) + "\n".join(out) + "\n"


def update(source_dir, out_dir):
    out_dir.mkdir(parents=True, exist_ok=True)
    wanted = {}
    for name, names in APPS.items():
        wanted[name] = (names, False)
    for name in HIDE:
        wanted[name] = (APPS.get(name), True)
    written = []
    for name, (names, hide) in sorted(wanted.items()):
        source = source_dir / name
        target = out_dir / name
        if not source.is_file():
            target.unlink(missing_ok=True)
            continue
        replace = EXEC_REPLACE.get(name) if Path(REPLACE_PROGRAM).exists() else None
        try:
            text = rewrite(source.read_text(encoding="utf-8"), str(source), names, hide,
                           EXEC_OPTIONS.get(name, ""), DROP_KEYS.get(name, ()), replace, ICONS.get(name, ""))
        except (OSError, UnicodeDecodeError, ValueError) as error:
            # One odd file must not break package installation.
            print(f"update-app-names: skipping {source}: {error}", file=sys.stderr)
            target.unlink(missing_ok=True)
            continue
        if not target.exists() or target.read_text(encoding="utf-8") != text:
            tmp = target.with_suffix(".tmp")
            tmp.write_text(text, encoding="utf-8")
            tmp.replace(target)
        written.append(name)
    # Overrides for applications that are no longer listed.
    for stale in out_dir.glob("*.desktop"):
        if stale.name not in wanted:
            stale.unlink()
    update_shortcuts(source_dir, out_dir.parent / "kglobalaccel")
    update_defaults(source_dir, out_dir)
    return written


